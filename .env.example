PORT=3000
PERSISTENCE_DRIVER=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ainotetacker
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=meeting-artifacts
WHISPER_MODEL=tiny
DEFAULT_TRANSCRIPTION_PROVIDER=azure-speech-mai-transcribe-1.5
QWEN_ASR_ENDPOINT=
QWEN_ASR_MODEL=qwen3-asr-1.7b
QWEN_ASR_TIMEOUT_SECONDS=300
AZURE_SPEECH_MAI_ENDPOINT=
AZURE_SPEECH_MAI_MODEL=mai-transcribe-1.5
AZURE_SPEECH_MAI_API_KEY=
AZURE_SPEECH_MAI_API_VERSION=2025-10-15
AZURE_SPEECH_MAI_TIMEOUT_SECONDS=300
DEFAULT_SUMMARY_PROVIDER=azure-openai
DEPLOYMENT_MODE=cloud
# Control-plane summary-provider readiness; summary execution has its own worker process.
SUMMARY_ENABLED=true
SUMMARY_MODEL=gpt-5.6-luna
SUMMARY_REASONING_EFFORT=max
# Pricing catalog v1 has no authoritative gpt-5.6-luna rate. Token usage is
# retained, but actual USD stays unpriced/null until an exact rate is configured.
AI_PRICING_VERSION=v1
DEFAULT_DAILY_CLOUD_QUOTA_USD=5
LIVE_MEETING_RESERVATION_CAP_USD=1.5
CLOUD_QUOTA_TIMEZONE=UTC
ADMIN_EMAILS=
# 簡易管理者帳密登入（/admin 頁面）。未填則使用預設帳號 admin / 密碼 solomonvbuandy。
# ADMIN_CONSOLE_SESSION_SECRET 留空時，每次重啟會自動產生隨機簽章金鑰（重啟後舊 token 失效）。
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=solomonvbuandy
ADMIN_CONSOLE_SESSION_SECRET=
ADMIN_CONSOLE_SESSION_TTL_HOURS=12
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Finite timeout for each blocking connection/socket operation in an audio upload.
AZURE_OPENAI_TRANSCRIBE_TIMEOUT_SECONDS=300
# Cloud summary (摘要) + transcript polishing (潤稿) use the Azure Responses API
# (gpt-5.6-luna). Both summary-specific values are required; the worker does not
# reuse the transcription endpoint/key. Example endpoint:
# https://RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_SUMMARY_ENDPOINT=
AZURE_OPENAI_SUMMARY_API_KEY=
# Finite timeout for each blocking connection/socket operation in a summary request.
AZURE_OPENAI_SUMMARY_TIMEOUT_SECONDS=300
# Transcript style for gpt-4o-transcribe. Leave LANGUAGE blank to auto-detect.
# PROMPT biases the model toward Traditional Chinese (Taiwan) + punctuation; blank
# uses the built-in Traditional Chinese default. Set an English prompt for EN meetings.
AZURE_OPENAI_TRANSCRIBE_LANGUAGE=
AZURE_OPENAI_TRANSCRIBE_PROMPT=
# Optional speaker evidence. Configure all endpoint/model/key values together.
# The primary gpt-4o-transcribe text remains authoritative; this second model
# only adds alignment-gated anonymous speaker labels.
AZURE_OPENAI_DIARIZE_ENDPOINT=
AZURE_OPENAI_DIARIZE_MODEL=
AZURE_OPENAI_DIARIZE_API_KEY=
AZURE_OPENAI_DIARIZE_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DIARIZE_TIMEOUT_SECONDS=300
AZURE_OPENAI_DIARIZE_MAX_WORKERS=3
# The Responses model corrects only high-confidence ASR homophones, technical
# spelling, punctuation, and sentence boundaries. Immutable rawText is retained;
# unsafe output falls back to the raw-derived display text. Uses the summary
# endpoint/key. Blank model = reuse SUMMARY_MODEL (gpt-5.6-luna).
TRANSCRIPT_PUNCTUATION_ENABLED=true
AZURE_OPENAI_PUNCTUATION_MODEL=
TRANSCRIPT_POLISHING_REASONING_EFFORT=max
# Finite timeout for each blocking connection/socket operation in a punctuation request.
AZURE_OPENAI_PUNCTUATION_TIMEOUT_SECONDS=300
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CODEX_CLI_PATH=codex
# Browser Email-OTP UI is not provided. Leave both values blank for guest mode.
# Set a Supabase URL/key only to verify bearer tokens obtained by an external client.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CONTROL_PLANE_BASE_URL=http://control-plane:3000
# Finite timeout for each blocking connection/socket operation against the control plane.
CONTROL_PLANE_TIMEOUT_SECONDS=30
INTERNAL_SERVICE_TOKEN=internal-token
WORKER_ID=worker-alpha
ARTIFACT_BASE_URL=http://minio:9000/meeting-artifacts
POLL_INTERVAL_MS=1000
MAX_CONCURRENT_TRANSCRIPTION_JOBS=1
MAX_MEETING_JOB_BACKLOG=2
MAX_TRANSCRIPTION_JOB_BACKLOG=10
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
RECORDING_EXECUTOR=stub
MEETING_BOT_BASE_URL=http://meeting-bot:3000
MEETING_BOT_CONTAINER_NAME=ai_notetacker-meeting-bot-1
MEETING_BOT_STOP_TIMEOUT_SECONDS=90
MEETING_BOT_BEARER_TOKEN=internal-token
MEETING_BOT_BOT_NAME=AI NoteTacker
MEETING_BOT_TEAM_ID=meeting-bot-team
MEETING_BOT_TIMEZONE=UTC
MEETING_BOT_USER_ID=meeting-bot-user
