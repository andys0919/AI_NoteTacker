{
  "name": "ai-notetacker",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "build": "npm run build:node && npm run build:python",
    "build:node": "npm run build --workspaces --if-present",
    "build:python": "test -d workers/transcription-worker/src && python3 -m compileall -q workers/transcription-worker/src",
    "dev": "npm exec --workspace @ai-notetacker/control-plane -- tsx watch src/server.ts",
    "test": "npm run test:node && npm run test:python",
    "test:node": "npm run test --workspaces --if-present",
    "test:python": "PYTHONPATH=workers/transcription-worker/src python3 -m unittest discover -s workers/transcription-worker/tests -p 'test_*.py'"
  }
}
